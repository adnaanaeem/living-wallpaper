{
  "showHud": {
    "text": "Show weather panel",
    "type": "checkbox",
    "value": true
  },
  "units": {
    "text": "Temperature units",
    "type": "dropdown",
    "items": [ "Celsius", "Fahrenheit" ],
    "value": 0
  },
  "clock": {
    "text": "Clock format",
    "type": "dropdown",
    "items": [ "12-hour", "24-hour" ],
    "value": 0
  },
  "clockStyle": {
    "text": "Clock style",
    "type": "dropdown",
    "items": [ "Digital", "Analog" ],
    "value": 0
  },
  "hudPosition": {
    "text": "Weather panel position",
    "type": "dropdown",
    "items": [ "Top right", "Top left", "Bottom right", "Bottom left" ],
    "value": 0
  },
  "hudOpacity": {
    "text": "Weather panel transparency (%)",
    "type": "slider",
    "min": 15,
    "max": 100,
    "step": 5,
    "value": 100
  },
  "scene": {
    "text": "Illustrated scene",
    "type": "dropdown",
    "items": [ "Mountains & Lake", "City Skyline", "Ocean / Beach", "Desert Dunes", "Forest", "Aurora", "Snowy Village", "Waterfall Valley", "Rotate daily", "Random each launch" ],
    "value": 0
  },
  "cityName": {
    "text": "City label (optional)",
    "type": "textbox",
    "value": ""
  },
  "photoLabel": {
    "text": "Own photo background: tick the box below, then in 'Photo background' click the folder/＋ button to add your image (it gets copied into the wallpaper and displayed).",
    "type": "label",
    "value": ""
  },
  "usePhoto": {
    "text": "Use photo background",
    "type": "checkbox",
    "value": false
  },
  "photo": {
    "text": "Photo background",
    "type": "folderDropdown",
    "filter": "*.jpg|*.jpeg|*.png|*.webp|*.bmp",
    "folder": "backgrounds",
    "value": ""
  },
  "sound": {
    "text": "Ambient sound (rain / wind / crickets)",
    "type": "checkbox",
    "value": false
  }
}
